# ATLAS V2 (proposal) — settings. Copy this file to `.env` and change what you need.
# Every line is optional: the values shown are the defaults.

# The card creator shown in a frame on the Creator page. It is a separate project
# (https://github.com/straus91/roadmap-json). For the hand-over to work, the card creator
# must list THIS site's address in its own EMBED_ORIGINS setting.
# Leave empty to run without a Creator page.
CREATOR_URL=https://card-creator.pedsrad.org

# How often (hours) the cards are re-read from ATLAS's public pages. The last good copy is
# kept if ATLAS cannot be reached. 0 = never read them (the library stays as it is).
LIBRARY_SYNC_HOURS=24

# The port on your own computer (http://localhost:8001). Not used on a server behind a
# front-door web server.
APP_PORT=8001
