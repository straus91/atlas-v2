# ATLAS V2 (proposal) — settings. Copy this file to `.env` and change what you need.
# Every line is optional: the values shown are the defaults.

# The card creator shown in a frame on the Creator page. It is a separate project
# (https://github.com/straus91/roadmap-json). For the hand-over to work, the card creator
# must list THIS site's address in its own EMBED_ORIGINS setting.
# Leave empty to run without a Creator page.
CREATOR_URL=https://card-creator.pedsrad.org

# Where this server itself reaches the card creator. Before a card corrected by its author is
# published, it is checked against the ATLAS schema there once more. Empty = the same address as
# CREATOR_URL, which is right on a server. On your own computer, with both sites in Docker, use
# http://host.docker.internal:8000 (inside a container, "localhost" is the container itself).
CREATOR_API_URL=

# How often (hours) the cards are re-read from ATLAS's public pages. The last good copy is
# kept if ATLAS cannot be reached. 0 = never read them (the library stays as it is).
LIBRARY_SYNC_HOURS=24

# ---- Author review -------------------------------------------------------------------
# A card shows "Author-reviewed" when its contact person confirmed it through a personal link
# and an administrator gave the final OK. All of this is off until a password is set.

# The password of the admin view (the "Admin" page). Empty = the site has no admin view.
ADMIN_PASSWORD=

# This site's public address, used for the personal links in emails, for example
# https://atlas-v2.pedsrad.org. Empty = the address the administrator's browser uses.
SITE_URL=

# The mail server validation emails are sent through (any provider's SMTP settings).
# Without SMTP_HOST and MAIL_FROM no email is ever sent: the admin view then makes the
# personal links and shows them, to be sent by hand.
# On a server that blocks ports 25, 465 and 587 (DigitalOcean does), use the provider's other
# port, usually 2525. A password with special characters goes in single quotes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The address the emails come from, and (optional) the one replies should go to.
MAIL_FROM=
MAIL_REPLY_TO=

# The port on your own computer (http://localhost:8001). Not used on a server behind a
# front-door web server.
APP_PORT=8001
